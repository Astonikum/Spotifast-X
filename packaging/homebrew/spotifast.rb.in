cask "spotifast-x" do
  version "@VERSION@"
  sha256 "@MACOS_SHA256@"

  url "https://github.com/Astonikum/Spotifast-X/releases/download/v#{version}/spotifast-v#{version}-macos-universal.dmg"
  name "Spotifast X"
  desc "Native Spotify client"
  homepage "https://spotifast.rocks"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "Spotifast X.app"

  zap trash: [
    "~/Library/Application Support/io.github.Astonikum.SpotifastX",
    "~/Library/Caches/io.github.Astonikum.SpotifastX",
  ]
end
