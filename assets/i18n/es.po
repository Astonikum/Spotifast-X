msgid "Use the current cover's colour on pages and the player bar."
msgstr ""
"Usa el color de la carátula actual en las páginas y en la barra del "
"reproductor."

#: src/ui/settings.rs:1206
msgid "Show names without covers in the sidebar."
msgstr "Muestra los nombres sin carátulas en la barra lateral."

#: src/ui/settings.rs:1210
